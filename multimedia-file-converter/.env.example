# =====================================================================
#  Konfiguracja Konwertera plików. Skopiuj ten plik do .env i uzupełnij.
#  Po każdej zmianie: docker compose up -d --build
# =====================================================================

# --- Tryb pracy --------------------------------------------------------
# development: bez SMTP kod logowania pokazuje się w przeglądarce (tylko do testów!)
# production:  kod jest wysyłany wyłącznie e-mailem; SMTP jest wtedy wymagany.
APP_ENV=production
# Długi, losowy sekret. Wygeneruj np.: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=zmien-ten-sekret-przed-wdrozeniem-produkcyjnym

# --- Dostęp sieciowy ---------------------------------------------------
# 0.0.0.0 = aplikacja dostępna z innych komputerów (http://IP-SERWERA:8000)
# 127.0.0.1 = tylko z tego komputera
BIND_ADDRESS=0.0.0.0
APP_PORT=8000
# true tylko, gdy przeglądarki łączą się przez HTTPS (Caddy, Cloudflare Tunnel).
# Przy zwykłym http://IP:8000 w sieci lokalnej musi być false, inaczej logowanie nie zadziała.
COOKIE_SECURE=false
# Domena dla trybu HTTPS z Caddy (docker compose --profile production up -d); odkomentuj i ustaw.
# DOMAIN=konwerter.twoja-domena.pl

# --- Poczta (kody logowania) -------------------------------------------
# Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_USER=twoj@gmail.com,
#        SMTP_PASSWORD=16-znakowe hasło aplikacji, SMTP_FROM=twoj@gmail.com
# Port 465: SMTP_SSL=true. Port 587: SMTP_SSL=false i SMTP_STARTTLS=true.
# Testowa skrzynka Mailpit: SMTP_HOST=mailpit, SMTP_PORT=1025, SMTP_STARTTLS=false
# Sprawdzenie: docker compose exec app python -m app.mailtest twoj@adres.pl
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_STARTTLS=false
SMTP_SSL=false

# Adresy e-mail administratorów (dostęp do dziennika), rozdzielone przecinkami.
ADMIN_EMAILS=

# --- Konwersje ---------------------------------------------------------
FFMPEG_BIN=ffmpeg
FFPROBE_BIN=ffprobe
# Liczba równoległych konwersji; nadmiar czeka w kolejce.
MAX_CONVERSIONS=2
# Wątki jednego procesu FFmpeg.
CONVERTER_THREADS=2
CONVERSION_TIMEOUT_SECONDS=1800
CONVERSION_CPU_SECONDS=3600
# Limit pamięci wirtualnej procesu FFmpeg w MB; 0 = wyłączony (pamięć ogranicza APP_MEMORY_LIMIT).
# Wartości poniżej ok. 2048 powodują błędy kodowania wideo.
CONVERTER_MEMORY_MB=0
# Limity kontenera Docker.
APP_MEMORY_LIMIT=1536m
APP_CPUS=2.0

# --- Ochrona logowania -------------------------------------------------
OTP_REQUESTS_PER_WINDOW=5
OTP_REQUEST_WINDOW_MINUTES=15

# Ilość aktywnych użytkowników w tym samym czasie; nadmiar czeka w kolejce. 
MAX_ACTIVE_USERS=10