# development | production
APP_ENV=development
# W produkcji ustaw długi, losowy sekret, np. openssl rand -hex 32.
SECRET_KEY=zmien-ten-sekret-przed-wdrozeniem-produkcyjnym
# Ustaw true tylko za HTTPS (np. za Caddy).
COOKIE_SECURE=false

# Ścieżka do FFmpeg / FFprobe; w obrazie Docker są dostępne na PATH.
FFMPEG_BIN=ffmpeg
FFPROBE_BIN=ffprobe
MAX_CONVERSIONS=2
CONVERSION_TIMEOUT_SECONDS=600
CONVERSION_CPU_SECONDS=540
CONVERTER_MEMORY_MB=512

# Ochrona logowania: liczba kodów, jaką jeden adres może zamówić w oknie czasowym.
OTP_REQUESTS_PER_WINDOW=5
OTP_REQUEST_WINDOW_MINUTES=15

# SMTP. Bez tych wartości w trybie development kod jest wyświetlany w interfejsie.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_STARTTLS=true

# Rozdziel przecinkami adresy administratorów uprawnionych do czytania dziennika.
ADMIN_EMAILS=
